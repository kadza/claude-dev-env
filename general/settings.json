{
  "permissions": {
    "allow": [
      "Bash(git diff*)",
      "Bash(git ls-files*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git config *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Skill(*)"
    ],
    "blockReadsOutsideWorkingDirectories": false
  },
  "model": "sonnet",
  "tui": "default",
  "theme": "dark",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/claude-dev-env/general/mods/m"
  }
}
